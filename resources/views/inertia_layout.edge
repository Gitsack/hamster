<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title inertia>
      Hamster
    </title>

    <script>
      /* Paint in the operator's theme before first paint. Key must match THEME_STORAGE_KEY. */
      (function() {
        try {
          var stored = null;
          try {
            stored = window.localStorage.getItem("hamster-theme");
          } catch (e) {}
          var theme = stored === "light" || stored === "dark" ? stored : null;
          if (!theme) {
            theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          var root = document.documentElement;
          root.classList.toggle("dark", theme === "dark");
          root.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>

    @stack('dumper')
    @viteReactRefresh()
    @inertiaHead()
    @vite(['inertia/app.tsx', `inertia/pages/${page.component}.tsx`])
  </head>

  <body class="min-h-screen w-full overflow-x-hidden font-sans">
    @inertia()
  </body>

</html>
