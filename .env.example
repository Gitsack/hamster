# ===========================================
# Hamster Configuration
# ===========================================
# Copy this file to .env and configure your settings

# -------------------------------------------
# User/Group IDs (Docker only)
# -------------------------------------------
# Set these to match your host user to avoid permission issues
# Run `id` on your host to find your UID and GID
PUID=1000
PGID=1000

# -------------------------------------------
# Application Settings
# -------------------------------------------
TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development
SESSION_DRIVER=cookie

# Session lifetime (default: 7d). Examples: 1h, 12h, 7d, 30d
# SESSION_AGE=7d

# Security Key - REQUIRED
# Generate with: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=

# Set to true if running behind HTTPS (reverse proxy with SSL)
# SECURE_COOKIES=true

# -------------------------------------------
# Service Host Mapping (local development)
# -------------------------------------------
# When developing locally with `npm run dev`, Docker service hostnames
# (e.g. "gluetun", "jellyfin") are unreachable from the host.
# This maps Docker hostnames to localhost so you don't have to
# reconfigure services in the UI when switching between Docker and dev.
# Format: docker_hostname:local_hostname,docker_hostname2:local_hostname2
# SERVICE_HOST_MAP=gluetun:localhost,jellyfin:localhost

# -------------------------------------------
# Service Path Mapping (local development)
# -------------------------------------------
# Same idea as SERVICE_HOST_MAP, but for filesystem paths. When the same
# volume is mounted at one location in Docker (e.g. /downloads) and a
# different location on the dev host (e.g. /mnt/nas/download), this rewrites
# DB-stored paths (download client localPath, output_path, etc.) at FS access
# time. Longest matching FROM prefix wins; segment boundary only.
# Format: docker_path:local_path,docker_path2:local_path2
# SERVICE_PATH_MAP=/downloads:/mnt/nas/download,/media:/mnt/nas/media

# -------------------------------------------
# Database Configuration
# -------------------------------------------
# For local development:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_DATABASE=hamster

# -------------------------------------------
# Docker Volume Paths (Docker only)
# -------------------------------------------
# These paths are mounted into the container
# Set these to your actual media library locations

# Music library path on host
MUSIC_PATH=/path/to/your/music

# Movies library path on host
MOVIES_PATH=/path/to/your/movies

# TV Shows library path on host
TV_PATH=/path/to/your/tv

# Books library path on host
BOOKS_PATH=/path/to/your/books

# Downloads folder (for import from download clients)
DOWNLOADS_PATH=/path/to/your/downloads